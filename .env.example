# MarxOS 默认 profile（启动脚本和直接运行 web_app.py 共用）
# P1 晋级后基线：corpus-v2 旁路重建（文集10卷 + 选集4卷）+ Milvus hybrid（dense + corpus BM25 sparse）
MARXOS_CORPUS_PROFILE=me_full_v2
MARXOS_RETRIEVAL_PROFILE=milvus_bgem3_v2
MARXOS_ANSWER_PROFILE=deepseek_default

# 生成服务
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型分层：deep 模式走 deepseek-v4-pro；fast/standard 模式与辅助任务
# （著作定位、引文验证、域外问答）走 deepseek-v4-flash。默认由
# MARXOS_ANSWER_PROFILE 决定，需要整体覆盖时再取消注释：
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_FLASH_MODEL=deepseek-v4-flash

# 检索与模型：CPU + corpus-aware BM25 sparse（corpus-v2 冻结参数 320/64）
MARXOS_VECTOR_BACKEND=milvus
MARXOS_EMBEDDING_MODEL=BAAI/bge-m3
MARXOS_EMBEDDING_DEVICE=cpu
MILVUS_URI=./data/milvus_lite/marxos_corpus_v2.db
MILVUS_COLLECTION=marxos_passages_v2
MILVUS_SPARSE_PROVIDER=bm25
MARXOS_BM25_STATS_PATH=data/artifacts/corpus_v2/bm25_stats_v2_1.json
MILVUS_HYBRID_SEARCH=1
BGE_M3_MAX_LENGTH=512

# macOS ARM：torch 与 Milvus Lite（FAISS 实现的 HNSW）共用 libomp，多线程检索会
# 段错误。必须在 libomp 初始化前设置；app.py / 启动脚本均已内置，这里仅作记录。
OMP_NUM_THREADS=1

# text-layer 语料与本地 sparse 索引
OCR_CACHE_DIR=data/ocr_cache_text_layer
PARAGRAPH_CACHE_PATH=data/artifacts/corpus_v2/paragraph_records_enriched_v2_1.jsonl
SEMANTIC_LIGHT_SPARSE_INDEX_PATH=data/sparse_paragraph_index_text_layer.pkl

# Web 与引文查找
MARXOS_WEB_HOST=127.0.0.1
MARXOS_WEB_PORT=7860
EXACT_QUOTE_LOOKUP_TIMEOUT_SEC=3
EXACT_QUOTE_GLOBAL_FALLBACK=0

# 回滚入口：切回 P0 旧基线（text_layer DB + lexical sparse + me_full 语料）
# MARXOS_CORPUS_PROFILE=me_full
# MARXOS_RETRIEVAL_PROFILE=milvus_bgem3_stable
# MILVUS_URI=./data/milvus_lite/marxos_text_layer_bgem3.db
# MILVUS_COLLECTION=marxos_text_layer_bgem3
# MILVUS_SPARSE_PROVIDER=lexical
# MARXOS_BM25_STATS_PATH=
# PARAGRAPH_CACHE_PATH=data/paragraph_cache_text_layer.jsonl
